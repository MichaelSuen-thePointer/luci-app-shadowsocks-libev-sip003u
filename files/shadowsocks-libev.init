USE_PROCD=1
START=99

ss_confdir=/var/etc/shadowsocks-libev
ss_bindir=/usr/bin

ssrules_uc="/usr/share/ss-rules/ss-rules.uc"
ssrules_nft="/etc/nftables.d/90-ss-rules.nft"
ssrules_policy_state="/var/run/ss-rules-policy-routing"

ss_mkjson_server_conf() {
	local cfgserver

	config_get cfgserver "$cfg" server
	[ -n "$cfgserver" ] || return 1
	eval "$(validate_server_section "$cfg" ss_validate_mklocal)"
	validate_server_section "$cfgserver" || return 1
	[ "$disabled" = 0 ] || return 1
	ss_mkjson_server_conf_ "$cfgserver"
}

ss_mkjson_server_conf_() {
	[ -n "$server_port" ] || return 1
	[ -z "$server" ] || json_add_string server "$server"
	json_add_int server_port "$server_port"
	[ -z "$method" ] || json_add_string method "$method"
	[ -z "$key" ] || json_add_string key "$key"
	[ -z "$password" ] || json_add_string password "$password"
	[ -z "$plugin" ] || json_add_string plugin "$plugin"
	[ -z "$plugin_opts" ] || json_add_string plugin_opts "$plugin_opts"
	[ -z "$plugin_mode" ] || json_add_string plugin_mode "$plugin_mode"
}

ss_mkjson_ss_local_conf() {
	ss_mkjson_server_conf
}

ss_mkjson_ss_redir_conf() {
	ss_mkjson_server_conf
}

ss_mkjson_ss_server_conf() {
	ss_mkjson_server_conf_
}

ss_mkjson_ss_tunnel_conf() {
	ss_mkjson_server_conf || return 1
	[ -n "$tunnel_address" ] || return 1
	json_add_string tunnel_address "$tunnel_address"
}

ss_xxx() {
	local cfg="$1"
	local cfgtype="$2"
	local bin="$ss_bindir/${cfgtype/_/-}"
	local confjson="$ss_confdir/$cfgtype.$cfg.json"

	[ -x "$bin" ] || return
	eval "$("validate_${cfgtype}_section" "$cfg" ss_validate_mklocal)"
	"validate_${cfgtype}_section" "$cfg" || return
	[ "$disabled" = 0 ] || return

	json_init
	ss_mkjson_${cfgtype}_conf || return
	json_add_boolean use_syslog 1
	json_add_boolean ipv6_first "$ipv6_first"
	json_add_boolean fast_open "$fast_open"
	json_add_boolean reuse_port "$reuse_port"
	json_add_boolean no_delay "$no_delay"
	[ -z "$local_address" ] || json_add_string local_address "$local_address"
	[ -z "$local_port" ] || json_add_int local_port "$local_port"
	[ -z "$local_ipv4_address" ] || json_add_string local_ipv4_address "$local_ipv4_address"
	[ -z "$local_ipv6_address" ] || json_add_string local_ipv6_address "$local_ipv6_address"
	[ -z "$mode" ] || json_add_string mode "$mode"
	[ -z "$mtu" ] || json_add_int mtu "$mtu"
	[ -z "$timeout" ] || json_add_int timeout "$timeout"
	[ -z "$user" ] || json_add_string user "$user"
	[ -z "$acl" ] || json_add_string acl "$acl"
	json_dump -i >"$confjson"

	procd_open_instance "$cfgtype.$cfg"
	procd_set_param command "$bin" -c "$confjson"
	[ "$verbose" = 0 ] || procd_append_param command -v
	if [ -n "$bind_address" ]; then
		echo "$cfgtype $cfg: uci option bind_address deprecated, please switch to local_address" >&2
		procd_append_param command -b "$bind_address"
	fi
	procd_set_param file "$confjson"
	procd_set_param respawn
	procd_close_instance
	ss_rules_cb
}

ss_rules_cb() {
	local cfgserver server

	if [ "$cfgtype" = ss_redir ]; then
		config_get cfgserver "$cfg" server
		config_get server "$cfgserver" server
		ss_redir_servers="$ss_redir_servers $server"
		if [ "$mode" = tcp_only -o "$mode" = "tcp_and_udp" ]; then
			ss_rules_redir_tcp_sections="$ss_rules_redir_tcp_sections $cfg"
		fi
		if [ "$mode" = udp_only -o "$mode" = "tcp_and_udp" ]; then
			ss_rules_redir_udp_sections="$ss_rules_redir_udp_sections $cfg"
		fi
	fi
}

ss_rules_log() {
	logger -t shadowsocks-libev "ss-rules: $*"
}

ss_rules_u32() {
	local value="$1"

	echo "$value" | grep -Eq '^(0x[0-9a-fA-F]+|0|[1-9][0-9]*)$' || return 1
	[ "$((value))" -ge 0 ] 2>/dev/null || return 1
	[ "$((value))" -le 4294967295 ] 2>/dev/null || return 1
}

ss_rules_list_has() {
	local needle="$1"
	local list="$2"
	local item

	for item in $list; do
		[ "$item" = "$needle" ] && return 0
	done
	return 1
}

ss_rules_redir_port() {
	local redir="$1"
	local protocol="$2"
	local cfgtype disabled mode local_port sections

	config_get cfgtype "$redir" TYPE
	[ "$cfgtype" = ss_redir ] || {
		ss_rules_log "$protocol redir '$redir' does not exist"
		return 1
	}
	validate_ss_redir_section "$redir" || {
		ss_rules_log "$protocol redir '$redir' has invalid configuration"
		return 1
	}
	config_get_bool disabled "$redir" disabled 0
	[ "$disabled" = 0 ] || {
		ss_rules_log "$protocol redir '$redir' is disabled"
		return 1
	}
	config_get mode "$redir" mode tcp_only
	case "$protocol:$mode" in
		tcp:tcp_only|tcp:tcp_and_udp)
			sections="$ss_rules_redir_tcp_sections"
			;;
		udp:udp_only|udp:tcp_and_udp)
			sections="$ss_rules_redir_udp_sections"
			;;
		*)
			ss_rules_log "$protocol redir '$redir' does not enable $protocol mode"
			return 1
			;;
	esac
	config_get local_port "$redir" local_port
	[ -n "$local_port" ] || {
		ss_rules_log "$protocol redir '$redir' has no local port"
		return 1
	}
	ss_rules_list_has "$redir" "$sections" || {
		ss_rules_log "$protocol redir '$redir' could not be prepared; check its server configuration"
		return 1
	}

	ssrules_redir_port="$local_port"
}

ss_rules_policy_config() {
	local mark_raw="$1"
	local mask_raw="$2"
	local table_raw="$3"
	local priority_raw="$4"
	local mark_num mask_num table_num priority_num

	ss_rules_u32 "$mark_raw" || {
		ss_rules_log "invalid tproxy_mark '$mark_raw'"
		return 1
	}
	ss_rules_u32 "$mask_raw" || {
		ss_rules_log "invalid tproxy_mark_mask '$mask_raw'"
		return 1
	}
	ss_rules_u32 "$table_raw" || {
		ss_rules_log "invalid tproxy_route_table '$table_raw'"
		return 1
	}
	ss_rules_u32 "$priority_raw" || {
		ss_rules_log "invalid tproxy_rule_priority '$priority_raw'"
		return 1
	}

	mark_num="$((mark_raw))"
	mask_num="$((mask_raw))"
	table_num="$((table_raw))"
	priority_num="$((priority_raw))"

	[ "$mark_num" -ne 0 ] || {
		ss_rules_log "tproxy_mark must not be zero"
		return 1
	}
	[ "$mask_num" -ne 0 ] || {
		ss_rules_log "tproxy_mark_mask must not be zero"
		return 1
	}
	[ "$((mark_num & mask_num))" -eq "$mark_num" ] || {
		ss_rules_log "tproxy_mark must not set bits outside tproxy_mark_mask"
		return 1
	}
	case "$table_num" in
		0|253|254|255)
			ss_rules_log "tproxy_route_table $table_num is reserved"
			return 1
			;;
	esac
	[ "$priority_num" -ne 0 ] || {
		ss_rules_log "tproxy_rule_priority must not be zero"
		return 1
	}

	ssrules_policy_mark="$(printf '0x%08x' "$mark_num")"
	ssrules_policy_mask="$(printf '0x%08x' "$mask_num")"
	ssrules_policy_keep_mask="$(printf '0x%08x' "$((0xffffffff ^ mask_num))")"
	ssrules_policy_table="$table_num"
	ssrules_policy_priority="$priority_num"
}

ss_rules_policy_state_read() {
	local state_table state_priority extra

	[ -f "$ssrules_policy_state" ] || return 1
	read -r state_table state_priority extra <"$ssrules_policy_state" || return 1
	[ -z "$extra" ] || return 1
	ss_rules_u32 "$state_table" || return 1
	ss_rules_u32 "$state_priority" || return 1

	ssrules_state_table="$((state_table))"
	ssrules_state_priority="$((state_priority))"
}

ss_rules_policy_table_check() {
	local family="$1"
	local routes

	routes="$(ip "$family" -n route show table "$ssrules_policy_table" 2>/dev/null)" || return 1
	[ -z "$routes" ] || {
		ss_rules_log "$family routing table $ssrules_policy_table is already in use"
		return 1
	}
}

ss_rules_policy_priority_check() {
	local family="$1"
	local rules line

	rules="$(ip "$family" -n rule show 2>/dev/null)" || return 1
	while IFS= read -r line; do
		case "$line" in
			"$ssrules_policy_priority:"*)
				ss_rules_log "$family rule priority $ssrules_policy_priority is already in use: $line"
				return 1
				;;
		esac
	done <<-EOF
	$rules
	EOF
}

ss_rules_policy_conflict_check() {
	local family

	for family in -4 -6; do
		ss_rules_policy_table_check "$family" || return 1
		ss_rules_policy_priority_check "$family" || return 1
	done
}

ss_rules_policy_reset() {
	local family

	[ -f "$ssrules_policy_state" ] || return 0
	if ! ss_rules_policy_state_read; then
		ss_rules_log "refusing to clean malformed policy-routing state $ssrules_policy_state"
		return 1
	fi

	for family in -4 -6; do
		ip "$family" rule del priority "$ssrules_state_priority" 2>/dev/null || true
		ip "$family" route flush table "$ssrules_state_table" 2>/dev/null || true
	done
	rm -f "$ssrules_policy_state"
}

ss_rules_policy_setup() {
	local family state_tmp

	ss_rules_policy_reset || return 1
	ss_rules_policy_conflict_check || return 1

	state_tmp="$ssrules_policy_state.$$"
	if ! echo "$ssrules_policy_table $ssrules_policy_priority" >"$state_tmp" \
		|| ! mv "$state_tmp" "$ssrules_policy_state"; then
		ss_rules_log "failed to record policy-routing ownership"
		rm -f "$state_tmp"
		return 1
	fi

	for family in -4 -6; do
		if ! ip "$family" route add local default dev lo table "$ssrules_policy_table"; then
			ss_rules_log "failed to add $family local route in table $ssrules_policy_table"
			ss_rules_policy_reset
			return 1
		fi
	done
	for family in -4 -6; do
		if ! ip "$family" rule add priority "$ssrules_policy_priority" \
			fwmark "$ssrules_policy_mark/$ssrules_policy_mask" lookup "$ssrules_policy_table"; then
			ss_rules_log "failed to add $family policy rule"
			ss_rules_policy_reset
			return 1
		fi
	done
}

ss_rules_policy_legacy_reset() {
	local family

	[ -f "$ssrules_nft" ] || return 0
	grep -Fq 'meta mark set 1 tproxy' "$ssrules_nft" || return 0
	ss_rules_log "removing policy-routing entries owned by the legacy mark 1/table 100 rules"
	for family in -4 -6; do
		ip "$family" rule del fwmark 1 lookup 100 2>/dev/null || true
		ip "$family" route del local default dev lo table 100 2>/dev/null || true
	done
}

ss_rules_nft_gen() {
	local cfg="ss_rules"
	local cfgtype
	local local_port_tcp local_port_udp
	local remote_servers tmp nft_tmp

	[ -s "$ssrules_uc" ] || {
		ss_rules_log "rule template $ssrules_uc is missing or empty"
		return 1
	}

	config_get cfgtype "$cfg" TYPE
	[ "$cfgtype" = ss_rules ] || {
		ss_rules_log "ss_rules configuration section is missing"
		return 1
	}

	eval "$(validate_ss_rules_section "$cfg" ss_validate_mklocal)"
	validate_ss_rules_section "$cfg" || {
		ss_rules_log "ss_rules configuration is invalid"
		return 1
	}
	[ "$disabled" = 0 ] || return 2

	if [ -n "$redir_tcp" ]; then
		ss_rules_redir_port "$redir_tcp" tcp || return 1
		local_port_tcp="$ssrules_redir_port"
	fi
	if [ -n "$redir_udp" ]; then
		ss_rules_redir_port "$redir_udp" udp || return 1
		local_port_udp="$ssrules_redir_port"
	fi
	[ -n "$local_port_tcp" -o -n "$local_port_udp" ] || {
		ss_rules_log "neither TCP nor UDP redir is configured"
		return 1
	}
	if [ -n "$local_port_udp" ]; then
		ss_rules_policy_config "$tproxy_mark" "$tproxy_mark_mask" \
			"$tproxy_route_table" "$tproxy_rule_priority" || return 1
	else
		ssrules_policy_mark="0x00000000"
		ssrules_policy_mask="0x00000000"
		ssrules_policy_keep_mask="0xffffffff"
	fi
	remote_servers="$(echo $ss_redir_servers \
		| tr ' ' '\n' \
		| sort -u \
		| xargs -n 1 resolveip \
		| sort -u)"

	tmp="$(mktemp -d /tmp/ssrules.XXXXXX)" || {
		ss_rules_log "failed to create a temporary rule directory"
		return 1
	}
	json_init
	json_add_string o_remote_servers "$remote_servers"
	json_add_int o_redir_tcp_port "$local_port_tcp"
	json_add_int o_redir_udp_port "$local_port_udp"
	json_add_string o_ifnames "$ifnames"
	json_add_string o_local_default "$local_default"
	json_add_string o_src_bypass "$src_ips_bypass"
	json_add_string o_src_forward "$src_ips_forward"
	json_add_string o_src_checkdst "$src_ips_checkdst"
	json_add_string o_src_default "$src_default"
	json_add_string o_dst_bypass "$dst_ips_bypass"
	json_add_string o_dst_forward "$dst_ips_forward"
	json_add_string o_dst_bypass_file "$dst_ips_bypass_file"
	json_add_string o_dst_forward_file "$dst_ips_forward_file"
	json_add_string o_dst_default "$dst_default"
	json_add_string o_nft_tcp_extra "$nft_tcp_extra"
	json_add_string o_nft_udp_extra "$nft_udp_extra"
	json_add_string o_tproxy_mark "$ssrules_policy_mark"
	json_add_string o_tproxy_mark_keep_mask "$ssrules_policy_keep_mask"
	if ! json_dump -i >"$tmp/options.json"; then
		ss_rules_log "failed to write rule rendering options"
		rm -rf "$tmp"
		return 1
	fi

	if ! utpl -S -F "$tmp/options.json" "$ssrules_uc" >"$tmp/rules.nft"; then
		ss_rules_log "failed to render nftables rules"
		rm -rf "$tmp"
		return 1
	fi
	echo "table inet chk {include \"$tmp/rules.nft\";}" >"$tmp/check.nft"
	if ! nft -f "$tmp/check.nft" -c; then
		ss_rules_log "generated nftables rules failed validation"
		rm -rf "$tmp"
		return 1
	fi
	ss_rules_policy_legacy_reset

	if [ -n "$local_port_udp" ]; then
		ss_rules_policy_setup || {
			rm -rf "$tmp"
			return 1
		}
	else
		ss_rules_policy_reset || {
			rm -rf "$tmp"
			return 1
		}
	fi

	if ! cmp -s "$tmp/rules.nft" "$ssrules_nft"; then
		nft_tmp="$ssrules_nft.$$"
		if ! cp "$tmp/rules.nft" "$nft_tmp" || ! mv "$nft_tmp" "$ssrules_nft"; then
			ss_rules_log "failed to install generated nftables rules"
			rm -f "$nft_tmp"
			rm -rf "$tmp"
			return 1
		fi
		if ! fw4 reload; then
			ss_rules_log "firewall reload failed"
			rm -rf "$tmp"
			return 1
		fi
	fi
	rm -rf "$tmp"
}

ss_rules_nft_reset() {
	if [ -f "$ssrules_nft" ]; then
		ss_rules_policy_legacy_reset
		if ! rm -f "$ssrules_nft"; then
			ss_rules_log "failed to remove generated nftables rules"
			return 1
		fi
		if ! fw4 reload; then
			ss_rules_log "firewall reload failed while removing ss-rules"
			return 1
		fi
	fi
}

ss_rules() {
	local rc cleanup_rc=0

	ss_rules_nft_gen
	rc=$?
	case "$rc" in
		0)
			return 0
			;;
		2)
			ss_rules_nft_reset || cleanup_rc=1
			ss_rules_policy_reset || cleanup_rc=1
			[ "$cleanup_rc" = 0 ] || {
				ss_rules_log "failed to disable all active rules"
				return 1
			}
			return 0
			;;
		*)
			ss_rules_nft_reset || cleanup_rc=1
			ss_rules_policy_reset || cleanup_rc=1
			if [ "$cleanup_rc" = 0 ]; then
				ss_rules_log "rule application failed; rules were removed and redir instances keep running"
			else
				ss_rules_log "rule application and cleanup failed; check the system log"
			fi
			return "$rc"
			;;
	esac
}

start_service() {
	local cfgtype

	# rc.common serializes stop/reload, but its procd start path is unlocked.
	procd_lock
	mkdir -p "$ss_confdir"
	config_load shadowsocks-libev
	for cfgtype in ss_local ss_redir ss_server ss_tunnel; do
		config_foreach ss_xxx "$cfgtype" "$cfgtype"
	done
	ss_rules
}

stop_service() {
	local rc=0

	ss_rules_nft_reset
	[ "$?" = 0 ] || rc=1
	ss_rules_policy_reset || rc=1
	rm -rf "$ss_confdir"
	return "$rc"
}

service_triggers() {
	procd_add_reload_interface_trigger wan
	procd_add_reload_trigger shadowsocks-libev
	procd_open_validate
	validate_server_section
	validate_ss_local_section
	validate_ss_redir_section
	validate_ss_rules_section
	validate_ss_server_section
	validate_ss_tunnel_section
	procd_close_validate
}

ss_validate_mklocal() {
	local tuple opts

	shift 2
	for tuple in "$@"; do
		opts="${tuple%%:*} $opts"
	done
	[ -z "$opts" ] || echo "local $opts"
}

ss_validate() {
	uci_validate_section shadowsocks-libev "$@"
}

validate_common_server_options_() {
	local cfgtype="$1"; shift
	local cfg="$1"; shift
	local func="$1"; shift
	local stream_methods='"table", "rc4", "rc4-md5", "aes-128-cfb", "aes-192-cfb", "aes-256-cfb", "aes-128-ctr", "aes-192-ctr", "aes-256-ctr", "bf-cfb", "camellia-128-cfb", "camellia-192-cfb", "camellia-256-cfb", "salsa20", "chacha20", "chacha20-ietf"'
	local aead_methods='"aes-128-gcm", "aes-192-gcm", "aes-256-gcm", "chacha20-ietf-poly1305", "xchacha20-ietf-poly1305"'

	"${func:-ss_validate}" "$cfgtype" "$cfg" "$@" \
		'disabled:bool:0' \
		'server:host' \
		'server_port:port' \
		'password:string' \
		'key:string' \
		"method:or($stream_methods, $aead_methods)" \
		'plugin:string' \
		'plugin_opts:string' \
		'plugin_mode:or("tcp_only", "udp_only", "tcp_and_udp")'
}

validate_common_client_options_() {
	validate_common_options_ "$@" \
		'server:uci("shadowsocks-libev", "@server")' \
		'local_address:ipaddr:0.0.0.0' \
		'local_port:port'
}

validate_common_options_() {
	local cfgtype="$1"; shift
	local cfg="$1"; shift
	local func="$1"; shift

	"${func:-ss_validate}" "$cfgtype" "$cfg" "$@" \
		'disabled:bool:0' \
		'fast_open:bool:0' \
		'ipv6_first:bool:0' \
		'no_delay:bool:0' \
		'reuse_port:bool:0' \
		'verbose:bool:0' \
		'mode:or("tcp_only", "udp_only", "tcp_and_udp"):tcp_only' \
		'mtu:uinteger' \
		'timeout:uinteger' \
		'user:string'
}

validate_server_section() {
	validate_common_server_options_ server "$1" "$2"
}

validate_ss_local_section() {
	validate_common_client_options_ ss_local "$1" "$2" \
		'acl:file'
}

validate_ss_redir_section() {
	validate_common_client_options_ ss_redir "$1" "$2"
}

validate_ss_rules_section() {
	"${2:-ss_validate}" ss_rules "$1" \
		'disabled:bool:0' \
		'redir_tcp:uci("shadowsocks-libev", "@ss_redir")' \
		'redir_udp:uci("shadowsocks-libev", "@ss_redir")' \
		'src_ips_bypass:or(ipaddr,cidr)' \
		'src_ips_forward:or(ipaddr,cidr)' \
		'src_ips_checkdst:or(ipaddr,cidr)' \
		'dst_ips_bypass_file:file' \
		'dst_ips_bypass:or(ipaddr,cidr)' \
		'dst_ips_forward_file:file' \
		'dst_ips_forward:or(ipaddr,cidr)' \
		'src_default:or("bypass", "forward", "checkdst"):checkdst' \
		'dst_default:or("bypass", "forward"):bypass' \
		'local_default:or("bypass", "forward", "checkdst"):bypass' \
		'nft_tcp_extra:string' \
		'nft_udp_extra:string' \
		'tproxy_mark:string:0x01000000' \
		'tproxy_mark_mask:string:0xff000000' \
		'tproxy_route_table:uinteger:1000' \
		'tproxy_rule_priority:uinteger:100' \
		'ifnames:maxlength(15)'
}

validate_ss_server_section() {
	validate_common_server_options_ ss_server "$1" \
		validate_common_options_ \
		"$2" \
		'local_address:ipaddr' \
		'local_ipv4_address:ip4addr' \
		'local_ipv6_address:ip6addr' \
		'bind_address:ipaddr' \
		'acl:file'
}

validate_ss_tunnel_section() {
	validate_common_client_options_ ss_tunnel "$1" \
		"$2" \
		'tunnel_address:regex(".+\:[0-9]+")'
}
